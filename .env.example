# ─────────────────────────────────────────────────────────────────────────────
# PDF Converter — root .env.example
# Copy to .env and adjust values before running Docker Compose.
# All defaults work out of the box for local development.
# ─────────────────────────────────────────────────────────────────────────────

# ── Frontend ──────────────────────────────────────────────────────────────────
WEB_PORT=3000

# Must be reachable from the END USER'S BROWSER (not from inside Docker).
# For local dev this is localhost; in production use your public API domain.
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Backend API ───────────────────────────────────────────────────────────────
API_PORT=8000
APP_NAME=PDF Converter API
LOG_LEVEL=INFO

# Comma-separated frontend origins allowed by CORS
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=pdf_converter
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5433                # host-side port (container always exposes 5432)

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PORT=6379

# ── MinIO (object storage) ────────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_RAW=raw-documents
MINIO_BUCKET_EXPORTS=excel-exports

# ── Azure Document Intelligence (optional — leave blank to disable) ────────────
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=

# ── BBC Dashboard (removable module — backend/app/bbc/README.md) ───────────────
BBC_DASHBOARD_ENABLED=true
BBC_SPREADSHEET_ID=                 # id между /d/ и /edit в URL Google-таблицы
BBC_SERVICE_ACCOUNT_JSON=bbc-sheets.json   # путь к файлу ИЛИ сам JSON (Railway)
BBC_WORKSHEET_NAME=                 # пусто = первый лист
BBC_CACHE_TTL_SECONDS=60
BBC_JOURNAL_SPREADSHEET_ID=         # журнал операций
BBC_SALES_SPREADSHEET_ID=           # общий реестр продаж
BBC_OMIP_SPREADSHEET_ID=            # «расчет плана ОМиП» (блок «Отдел продаж»)
BBC_MSFO_SPREADSHEET_ID=            # таблица-приёмник выгрузки МСФО (создаёт человек)
BBC_POLL_INTERVAL_SECONDS=15        # фоновый live-цикл; 0 = выключить
BBC_SESSION_TTL_HOURS=720           # сколько сессия живёт БЕЗ обращений (окно сдвигается)
BBC_PUBLIC_BASE_URL=                # база для реферальных ссылок
BBC_BOOTSTRAP_ADMIN=                # первый админ, пока bbc.users пуста
BBC_BOOTSTRAP_PASSWORD=

# Хранилище файлов, приложенных к касаниям (журнал касаний по долгам).
# Пусто = выбирается само: есть ключи S3 → R2, нет → байты в Postgres.
# Файловая система контейнера не используется: на Railway она стирается при
# каждом деплое, и приложенный скрин исчезал бы вместе с ней.
BBC_FILE_STORAGE=                   # s3 | postgres | пусто (авто)
BBC_S3_ENDPOINT=                    # https://<account>.r2.cloudflarestorage.com — БЕЗ имени бакета
BBC_S3_BUCKET=
BBC_S3_ACCESS_KEY_ID=
BBC_S3_SECRET_ACCESS_KEY=
BBC_S3_REGION=auto                  # у R2 регионов нет, но подпись S3v4 требует значения

# MCP-коннектор для приложения Claude: топ-менеджеры спрашивают отчётность
# словами, Claude читает Google-таблицы через /mcp/<секрет>.
#
# MCP_SECRET — это и есть пароль: диалог «Add custom connector» на claude.ai
# принимает только адрес, поля для заголовка там нет. Генерировать так:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Выключено по умолчанию: забытая переменная не должна означать открытый
# в интернет эндпоинт со всей отчётностью.
MCP_ENABLED=false
MCP_SECRET=                         # пусто ⇒ маршрута нет, даже при ENABLED=true
MCP_SERVICE_ACCOUNT_JSON=           # пусто ⇒ берётся BBC_SERVICE_ACCOUNT_JSON
MCP_ALLOWED_IDS=                    # id таблиц через запятую; пусто = всё, что расшарено
MCP_MAX_CELLS=20000                 # потолок ячеек в одном ответе
MCP_CACHE_TTL_SECONDS=60            # общая с дашбордом квота — 60 чтений/мин

# ── Стартовый экран ──────────────────────────────────────────────────────────
# Фоновое видео под четырьмя плитками. Один ролик на обе темы: читаемость
# держит вуаль поверх него, а не сам ролик.
#
# Переменная ФРОНТЕНДА и БЕЗ префикса NEXT_PUBLIC_ — намеренно. Публичные
# переменные Next вшивает в бандл во время `pnpm run build`, который идёт
# внутри Dockerfile, куда переменные Railway не попадают без объявления ARG.
# Здесь адрес читается на сервере при запросе, поэтому меняется перезапуском
# сервиса, без пересборки образа.
#
# Пусто ⇒ фон остаётся градиентным; битый адрес прячет ролик, а не оставляет
# чёрный прямоугольник.
#
# Адрес берётся в Cloudflare: R2 → бакет → Settings → Public access →
# R2.dev subdomain → Allow. Получится https://pub-<хеш>.r2.dev, к нему через
# слэш дописывается ключ объекта (имя файла с его папкой, если она есть).
HOME_VIDEO_URL=
